            </column>
            <column caption='YTD Avg Price' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;-&quot;$&quot;#,##0,.00K' name='[Calculation_544935622157238278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_544935622151102464]/[Calculation_544935622153269251]' />
            </column>
            <column caption='PYTD Avg Price' datatype='real' name='[Calculation_544935622157676551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[YTD Total Sales (copy)_544935622152011777]/[YTD Car Sold (copy)_544935622153719812]' />
            </column>
            <column caption='YoY Avg Growth' datatype='real' default-format='p0.00%' name='[Calculation_544935622157996040]' role='measure' type='quantitative'>
