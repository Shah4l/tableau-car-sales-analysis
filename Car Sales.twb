            <column datatype='string' name='[Transmission]' role='dimension' type='nominal' />
            <column caption='PYTD Car Sold ' datatype='integer' name='[YTD Car Sold (copy)_544935622153719812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF &#10;YEAR([Date])= {MAX(YEAR([Date]))} - 1&#10;THEN&#10;[Car_id]&#10;END)' />
            </column>
            <column caption='PYTD Total Sales ' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[YTD Total Sales (copy)_544935622152011777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF &#10;YEAR([Date])={FIXED : MAX(YEAR([Date]))}-1&#10;THEN&#10;[Price ($)]&#10;END)' />
            </column>
