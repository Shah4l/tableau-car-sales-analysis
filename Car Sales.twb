              <calculation class='tableau' formula='SUM(IF &#10;YEAR([Date])={FIXED : MAX(YEAR([Date]))}&#10;THEN&#10;[Price ($)]&#10;END)' />
            </column>
            <column caption='YTD Car Sold' datatype='integer' default-format='c&quot;#&quot;#,##0,.00K;-&quot;#&quot;#,##0,.00K' name='[Calculation_544935622153269251]' role='measure' type='quantitative'>
